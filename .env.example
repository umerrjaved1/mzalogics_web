# Copy to .env.local for development, and set the same keys on your host
# (Vercel / Netlify / server) for production.

# --- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mzalogics.com

# --- Booking ----------------------------------------------------------
# The scheduler embedded at /contact#book-call.
# Leave EMPTY and the contact page shows WhatsApp / phone / email instead —
# no button ever promises a booking the site cannot deliver.
# Use the plain booking page URL, e.g.
#   Cal.com    https://cal.com/mzalogics/discovery
#   Calendly   https://calendly.com/mzalogics/20min
NEXT_PUBLIC_CALENDAR_URL=

# --- Analytics --------------------------------------------------------
# Plausible only loads when this is set. Without it you cannot tell which
# changes actually win. Use the bare domain, e.g. mzalogics.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Email (contact form delivery) ------------------------------------
# Without RESEND_API_KEY the form returns 503 and the enquiry is lost.
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=
# Must be a domain you have verified in Resend.
RESEND_FROM=MZA Logics <hello@mzalogics.com>

# --- Lead backup ------------------------------------------------------
# Optional. If email delivery fails, the enquiry is POSTed here as JSON
# (Slack, Zapier, Make, n8n...). Every lead is ALSO written to the server
# log with the prefix "[lead]" so an enquiry is never silently dropped.
LEAD_WEBHOOK_URL=
